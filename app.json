{
  "expo": {
    "name": "BookLens",
    "slug": "BookLens",
    "scheme": "booklens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "grokKey": "xai-LEQSA80WkDNy4g6Q2RKKbSC7PE2dF85V6NGFJwtHIWOCeKfuT6Prh12RGCh0pIRDw4dle2udLneMGIaE"
    }
  }
}